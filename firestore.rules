rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /workspaces/{workspaceId} {
      allow read: if true;
      allow write: if request.resource != null && request.resource.data.size() < 1000000;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
